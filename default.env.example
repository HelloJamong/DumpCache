# DC Inside Gallery Configuration

# ===== 갤러리 설정 =====

# 멀티 갤러리 모드 (False=단일 갤러리, True=여러 갤러리 동시 수집)
MULTI_MODE=False

# 멀티 모드에서 수집할 갤러리 수 (2 또는 3, MULTI_MODE=True 일 때만 적용)
MULTI_GALLERY_COUNT=2

# 갤러리 URL (전체 URL 입력 시 자동으로 ID와 타입 파싱)
# 단일 모드: 이 주소만 사용 / 멀티 모드: 1번 갤러리
GALLERY_URL=갤러리 주소 입력

# 2번 갤러리 (MULTI_MODE=True 일 때 사용)
GALLERY_URL_2=

# 3번 갤러리 (MULTI_MODE=True 이고 MULTI_GALLERY_COUNT=3 일 때 사용)
GALLERY_URL_3=

# ===== 수집 동작 =====

# 기본 수집 간격 (초 단위, 60 = 1분)
# 차단 의심 응답이 이어지면 다음 주기마다 30초씩 늘리고, 차단 미감지 시 이 값으로 복구
CRAWL_INTERVAL=60

# 한 사이클에 처리할 "새" 게시글 수 (공지 제외, 이미 수집한 게시글은 건너뜀)
MAX_POSTS_PER_CYCLE=10

# ===== 경로 (컨테이너 내부 경로, 변경 비추천) =====

# 이미지 저장 경로. 실제 저장은 IMAGE_SAVE_PATH/<갤러리명>/ 하위에 이루어짐
IMAGE_SAVE_PATH=/app/data/images

# 메타데이터 DB 경로
METADATA_DB_PATH=/app/data/metadata.db

# 디버그 모드 (True/False)
DEBUG=False

# HTTP 응답 진단 로그 (상태·지연·크기·최종 URL·본문 해시, 민감 쿼리 값은 마스킹)
# 장애 원인 분석을 위해 기본 활성화하며, 로그량을 줄이려면 False로 변경
HTTP_DIAGNOSTICS=True
